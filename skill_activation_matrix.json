{
  "schema_version": 1,
  "matrix": "configs/bot_role_and_skill_matrix.json",
  "app_connection_policy": {
    "auto_open_on_boot": false,
    "auto_open_on_hermes_startup": false,
    "lazy_execution_mode": "ON_DEMAND_ONLY",
    "jev_model_routing": false,
    "bridge_skill": "cli-anything-universal-bridge",
    "registry_scope": "hermes_profile",
    "open_requires_explicit_request": true
  },
  "triggers": [
    {
      "id": "session",
      "activation": "instructions_only",
      "rules": [
        "Gunakan persona dan batas proyek untuk sesi berjalan."
      ]
    },
    {
      "id": "context",
      "activation": "select_relevant_skills",
      "rules": [
        "Muat instruksi skill bundel yang sesuai topik dan peran.",
        "Periksa ketersediaan rujukan eksternal sebelum dipakai."
      ]
    },
    {
      "id": "task",
      "activation": "on_demand_only",
      "rules": [
        "Buka adapter hanya untuk tugas yang sedang diminta.",
        "Pertahankan konfigurasi provider dan model host.",
        "Periksa izin, kemampuan, dan biaya sebelum eksekusi."
      ]
    }
  ],
  "budget_policy": {
    "reserve_usd": 1,
    "automatic_billing_guarantee": false,
    "estimated_or_stale_balance": "pause_paid_automation_and_report"
  },
  "incident_policy": {
    "default": "explicit_authorization",
    "preauthorized_emergency": "alert_then_act_within_scope_then_report",
    "requires_preapproved_scope": true
  },
  "priority": [
    "user_authorization",
    "project_scope",
    "available_capabilities",
    "bot_routing"
  ],
  "browser_policy": {
    "schema": 1,
    "preferred_provider": "hermes-steel",
    "native_setting": "browser.cloud_provider=steel",
    "activation": "on_task",
    "auto_open_on_boot": false,
    "fallback": {
      "providers": [
        "chrome",
        "edge",
        "other_user_browser"
      ],
      "approval_required": true,
      "personal_account_required": true
    },
    "account_transfer": {
      "approval_required": true,
      "scope": [
        "source_browser",
        "destination",
        "account",
        "data",
        "duration"
      ],
      "automatic_cookie_extraction": false,
      "implementation": "review supported Steel session or manual login before transfer"
    },
    "cloud_usage": {
      "requires_user_account": true,
      "budget_check_before_paid_session": true,
      "free_usage_not_guaranteed": true
    }
  },
  "timesfm_policy": {
    "owner": "val",
    "activation": "contextual_on_forecasting_task",
    "auto_open_on_boot": false,
    "llm_provider_model_mutation": false,
    "input_validation_required": true,
    "runtime": "isolated_local_cpu",
    "daemon": false,
    "cloud_inference": false
  }
}
