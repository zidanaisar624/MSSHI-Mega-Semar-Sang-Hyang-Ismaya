{
  "schema": 2,
  "preferred_provider": "hermes-steel",
  "native_setting": "browser.cloud_provider=steel",
  "native_plugins": ["browser-steel", "msshi-steel-policy"],
  "official_source": "https://github.com/steel-dev/hermes-steel.git",
  "official_commit": "d8a1e39657d3e3deaa59da37e857be3f14b9dc5b",
  "activation": "on_authorized_task",
  "auto_open_on_boot": false,
  "session_scope": "one browser_exec batch, release in finally",
  "local_fallback": false,
  "strict_route": "supported tool_execution middleware with child-only explicit CDP",
  "fallback": {"tool": "msshi_personal_browser", "approval_required": true,
    "personal_account_required": true, "operator_attached_cdp_required": true,
    "automatic_browser_launch": false, "automatic_profile_copy": false},
  "account_transfer": {"approval_required": true,
    "scope": ["source_browser", "destination", "account", "data", "duration"],
    "automatic_cookie_extraction": false, "implemented": false},
  "cloud_usage": {"requires_account_or_compatible_self_host": true,
    "native_human_approval_before_each_batch": true, "free_usage_not_guaranteed": true,
    "provider_hard_spending_cap": false, "paid_proxy_captcha": false,
    "session_hard_timeout_ms": 180000},
  "status_does_not_authenticate_or_create_sessions": true
}
