{
  "schema_version": 1,
  "matrix": "configs/bot_role_and_skill_matrix.json",
  "app_connection_policy": {
    "auto_open_on_boot": false,
    "auto_open_on_hermes_startup": false,
    "lazy_execution_mode": "ON_DEMAND_ONLY",
    "jev_model_routing": false,
    "bridge_skill": "cli-anything-universal-bridge",
    "registry_scope": "hermes_profile",
    "open_requires_explicit_request": true
  },
  "triggers": [
    {
      "id": "session",
      "activation": "instructions_only",
      "rules": [
        "Gunakan persona dan batas proyek untuk sesi berjalan."
      ]
    },
    {
      "id": "context",
      "activation": "select_relevant_skills",
      "rules": [
        "Muat instruksi skill bundel yang sesuai topik dan peran.",
        "Periksa ketersediaan rujukan eksternal sebelum dipakai."
      ]
    },
    {
      "id": "task",
      "activation": "on_demand_only",
      "rules": [
        "Buka adapter hanya untuk tugas yang sedang diminta.",
        "Pertahankan konfigurasi provider dan model host.",
        "Periksa izin, kemampuan, dan biaya sebelum eksekusi."
      ]
    }
  ],
  "budget_policy": {
    "reserve_usd": 1,
    "automatic_billing_guarantee": false,
    "estimated_or_stale_balance": "pause_paid_automation_and_report"
  },
  "incident_policy": {
    "default": "explicit_authorization",
    "preauthorized_emergency": "alert_then_act_within_scope_then_report",
    "requires_preapproved_scope": true
  },
  "priority": [
    "user_authorization",
    "project_scope",
    "available_capabilities",
    "bot_routing"
  ],
  "browser_policy": {
    "schema": 2,
    "preference_source": "private user browser selection",
    "providers": [
      "chrome",
      "edge",
      "firefox",
      "none"
    ],
    "auto_open_on_boot": false,
    "activation": "authorized_task_only",
    "automatic_cookie_extraction": false,
    "automatic_account_transfer": false,
    "cloud_provider_installed": false,
    "login": "manual user login; labels are not authentication",
    "no_selection": "leave existing user settings unchanged"
  },
  "timesfm_policy": {
    "owner": "val",
    "activation": "contextual_on_forecasting_task",
    "auto_open_on_boot": false,
    "llm_provider_model_mutation": false,
    "input_validation_required": true,
    "runtime": "isolated_local_cpu",
    "daemon": false,
    "cloud_inference": false
  },
  "v3_1_contextual_policy": {
    "unslop": {
      "roles": [
        "kiki-chii",
        "val",
        "shikaku"
      ],
      "activation": "on_relevant_task",
      "auto_open_on_boot": false,
      "provider_model_mutation": false,
      "purpose": "Audit dan perbaikan UI bertahap; Kiki arah visual, Val bukti dashboard, Coder implementasi."
    },
    "brag": {
      "roles": [
        "kiki-chii"
      ],
      "activation": "on_relevant_task",
      "auto_open_on_boot": false,
      "provider_model_mutation": false,
      "purpose": "Video peluncuran produk berbasis Hyperframes dengan Concepting First dan review manusia."
    },
    "scrapling": {
      "roles": [
        "val",
        "shikaku"
      ],
      "activation": "on_relevant_task",
      "auto_open_on_boot": false,
      "provider_model_mutation": false,
      "purpose": "Ekstraksi CSS/XPath dari HTML lokal dalam runtime parser terisolasi."
    },
    "harness2": {
      "roles": [
        "yukino",
        "shizuka",
        "val",
        "kiki-chii",
        "shikaku"
      ],
      "activation": "on_relevant_task",
      "auto_open_on_boot": false,
      "provider_model_mutation": false,
      "purpose": "Evaluasi harness Propose-Probe-Compose menggunakan demo deterministik dan proposal yang ditinjau manusia.",
      "live_harness_promotion": false,
      "paid_benchmarks_default": false,
      "human_review_required": true
    },
    "muza-skripsi-template": {
      "roles": [
        "yukino",
        "shizuka",
        "val",
        "solo",
        "antigravity"
      ],
      "pack": "thesis",
      "activation": "contextual_or_explicit_command",
      "trigger_examples": [
        "Buatkan aku template skripsi",
        "Buatkan aku templete skripsi",
        "format skripsi",
        "pedoman skripsi",
        "template tugas akhir",
        "muza-skripsi-template",
        "/muza-skripsi-template"
      ],
      "mandatory_workflow_stages": [
        "1_detect_context_and_intake_campus_or_guideline",
        "2_lookup_campus_identity_logo_and_extract_rules",
        "3_review_spec_rules_and_select_methodology_preset",
        "4_build_docx_template_and_optional_muza_search_injection",
        "5_audit_quality_and_deliver_with_ctrl_h_guide"
      ],
      "auto_open_on_boot": false,
      "provider_model_mutation": false,
      "purpose": "Merakit template Word (.docx) skripsi/tesis sesuai pedoman kampus, lookup logo & pejabat resmi, serta injeksi MuZA_Search v1.1."
    },
    "rea": {
      "roles": [
        "shikaku"
      ],
      "activation": "on_authorized_reverse_engineering_task_after_explicit_enable",
      "public_default": false,
      "auto_open_on_boot": false,
      "mcp_registration": false,
      "preferred_over_legacy_generic_rea_setup": true,
      "provider_model_mutation": false
    }
  },
  "contextual_integrations": {
    "career-ops": {
      "profiles": [
        "yukino",
        "shizuka",
        "val",
        "kiki-chii",
        "shikaku"
      ],
      "trigger": [
        "career",
        "cv",
        "job",
        "interview"
      ],
      "background_model_calls": false,
      "user_data": "private separate DATA_ROOT"
    },
    "remote-jobs": {
      "profiles": [
        "yukino",
        "shizuka",
        "val",
        "kiki-chii",
        "shikaku"
      ],
      "trigger": [
        "remote work",
        "job search"
      ],
      "background_model_calls": false,
      "active_vacancies_verified": false
    },
    "mattpocock-engineering": {
      "profiles": [
        "yukino",
        "shizuka",
        "val",
        "kiki-chii",
        "shikaku"
      ],
      "trigger": [
        "engineering",
        "architecture",
        "specification",
        "tdd"
      ],
      "respect_explicit_only_upstream": true,
      "automatic_tracker_publication": false
    },
    "harness2": {
      "profiles": [
        "yukino",
        "shizuka",
        "val",
        "kiki-chii",
        "shikaku"
      ],
      "trigger": [
        "harness evaluation",
        "proposal",
        "deterministic demo"
      ],
      "automatic_promotion": false,
      "automatic_model_benchmarks": false
    },
    "rea-video": {
      "profiles": [
        "kiki-chii"
      ],
      "trigger": [
        "reference video",
        "shot breakdown",
        "remake plan"
      ],
      "automatic_model_downloads": false,
      "automatic_vlm_calls": false
    }
  },
  "contextual_loading_note": "Full skill/source loaded only when relevant. Host skill index/metadata may still consume context; no zero-billing guarantee.",
  "interaction_policy": {
    "version": "3.1.2",
    "type_1": [
      "yukino",
      "shizuka"
    ],
    "type_2": [
      "shikaku",
      "val",
      "kiki-chii"
    ],
    "full_task_rounds": 2,
    "fast_chat": "main_only",
    "ambiguous_direct": "ask_user_before_heavy_work",
    "ambiguous_forwarded": "ask_immediate_sender_then_user_if_needed",
    "type_2_separate_subagent": false,
    "settings": "user_owned_native_configuration",
    "source_enrichment": "main_brokered_authorized_tools_with_evidence",
    "missing_role_configuration": "stop_and_report_no_default_model_injection",
    "automatic_paid_test": false,
    "documentation": "docs/INTERAKSI_DUA_TIPE.md"
  }
}
